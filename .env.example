# Application environment
ENVIRONMENT=development

DATABASE_URL=postgresql://postgres:postgres@db:5432/mydatabase

# Initial admin user created at startup if no admin exists.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe_Password@123

# Security
JWT_SECRET_KEY=change-this-to-a-strong-secret-in-production

# Static analysis configuration
ENABLED_SAST_ANALYZERS=semgrep,bandit
SEMGREP_RULESET=auto
BANDIT_SEVERITY=medium
BANDIT_CONFIDENCE=medium

# LLM provider API keys
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


